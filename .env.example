# Copy to .env.local and fill in to build against a real Sanity project.
# Leave everything unset to build/dev against the local mock content in
# lib/cms/fixtures/ instead (no Sanity account needed).

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Read token with viewer access, used only at build time (never exposed to the browser).
SANITY_API_TOKEN=

# Also exposed to the Sanity Studio config (sanity/env.ts) as NEXT_PUBLIC_* equivalents:
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# production | staging — controls indexability/canonical URLs (PRD section 44).
DEPLOY_ENV=production
