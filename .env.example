# production | staging — controls indexability/canonical URLs (PRD section 44).
DEPLOY_ENV=production

# Only used when DEPLOY_ENV=staging: overrides the canonical/OG base URL so
# staging builds don't leak the production domain. See lib/site.ts.
SITE_URL=

# Public client key only, reused Flexperiment SmartCaptcha component.
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_SITE_KEY=
# The private YANDEX_SMARTCAPTCHA_SERVER_KEY belongs to Coolify project shared
# variables / future Commerce runtime; never put it in this website environment.

# SSR runtime reads only the anonymous Commerce public projection.
COMMERCE_PUBLIC_API_URL=http://127.0.0.1:4010
