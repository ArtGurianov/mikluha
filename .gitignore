# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/sanity/node_modules
/sanity/.sanity
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# CMS build pipeline (regenerated by npm run sync:cms / materialize:assets — never a source of truth)
/.cms-cache/
/public/generated/cms/
/app/icon.png
/app/apple-icon.png
/sanity-studio-out/

# Intermediate artifact of `sanity schema extract` (npm run cms:types). The
# generated types it feeds — lib/cms/generated/sanity.types.ts — ARE committed,
# so schema changes show up as a reviewable diff of the content contract.
/sanity/schema.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
