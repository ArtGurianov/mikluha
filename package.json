{
  "name": "mikluha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync:cms && npm run materialize:assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "clean": "rm -rf .next out public/generated/cms .cms-cache",
    "cms:types": "cd sanity && sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "cms:types:check": "npm run cms:types && git diff --exit-code lib/cms/generated/sanity.types.ts",
    "sync:cms": "tsx scripts/sync-sanity-content.ts",
    "materialize:assets": "tsx scripts/materialize-assets.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:out": "tsx scripts/validate-static-export.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "build:production": "npm run clean && npm run cms:types && npm run lint && npm run test && npm run sync:cms && npm run materialize:assets && npm run validate:content && npm run build && npm run validate:out",
    "seed:mock": "tsx scripts/seed-mock-content.ts",
    "studio:dev": "cd sanity && sanity dev",
    "studio:build": "cd sanity && sanity build ../sanity-studio-out",
    "studio:deploy": "cd sanity && sanity deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@portabletext/react": "^8.0.0",
    "@sanity/client": "^8.0.0",
    "@sanity/image-url": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sanity/vision": "^6.9.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "groq": "^6.9.2",
    "sanity": "^6.9.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3"
}
