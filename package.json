{
  "name": "mikluha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm run prepare:site",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "clean": "rm -rf .next .site-build public/release.json",
    "write:release": "tsx scripts/write-release-descriptor.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "build:production": "pnpm run clean && pnpm run lint && pnpm run test && pnpm run prepare:site && pnpm run validate:content -- --baked && pnpm run write:release && next build",
    "build:ssr": "pnpm run build:production",
    "prepare:site": "tsx scripts/prepare-site.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3"
}
