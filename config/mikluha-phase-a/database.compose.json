{
  "name": "mikluha-phase-a-acceptance",
  "services": {
    "postgres": {
      "image": "postgres@sha256:cbf42f0edc946c0bc1b8eeed62403734e1f25dc67a3491455d07a92fdb558b28",
      "restart": "unless-stopped",
      "init": true,
      "mem_limit": "512m",
      "cpus": 0.75,
      "pids_limit": 128,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": false,
      "tmpfs": [
        "/tmp:size=16m,mode=1777,noexec,nosuid,nodev",
        "/var/run/postgresql:size=8m,mode=3775"
      ],
      "stop_grace_period": "180s",
      "labels": [
        "traefik.enable=false",
        "coolify.managed=true",
        "coolify.type=application",
        "coolify.applicationId=${MAA_APPLICATION_UUID:?Coolify UUID required}",
        "io.mikluha.scope=acceptance",
        "io.mikluha.component=postgres",
        "io.mikluha.database-generation=${MAA_DATABASE_GENERATION:?stable DB generation required}"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "networks": [
        "db"
      ],
      "cap_add": [
        "CHOWN",
        "FOWNER",
        "DAC_OVERRIDE",
        "SETGID",
        "SETUID"
      ],
      "environment": {
        "POSTGRES_DB": "mikluha",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "${MAA_POSTGRES_PASSWORD:?Coolify secret required}",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256"
      },
      "volumes": [
        "pg-data:/var/lib/postgresql/data"
      ],
      "command": [
        "postgres",
        "-c",
        "max_connections=40",
        "-c",
        "shared_buffers=128MB",
        "-c",
        "log_statement=none",
        "-c",
        "log_min_error_statement=panic"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d mikluha"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 10
      }
    }
  },
  "networks": {
    "db": {
      "name": "mikluha-phase-a-acceptance-db",
      "internal": true
    }
  },
  "volumes": {
    "pg-data": {
      "name": "mikluha-phase-a-acceptance-pg-data"
    }
  }
}
